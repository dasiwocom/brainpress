{
    "name": "brainpress/brainpress",
    "description": "A small Markdown-native publishing app",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "league/commonmark": "^2.7",
        "symfony/yaml": "^7.0"
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
        "test": [
            "php tests/smoke.php",
            "php tests/extensions.php",
            "php tests/frontmatter.php",
            "php tests/admin.php",
            "php tests/i18n.php",
            "php tests/layout-menu.php",
            "php tests/post-cover.php",
            "php tests/footer.php",
            "php tests/links.php",
            "php tests/admin-navigation.php",
            "php tests/navigation-account.php",
            "php tests/urls.php"
        ]
    }
}
